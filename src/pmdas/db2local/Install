#! /bin/sh
#
# Copyright (c) 2026 Red Hat.
#
. $PCP_DIR/etc/pcp.env
. $PCP_SHARE_DIR/lib/pmdaproc.sh

iam=db2local
domain=44
python_opt=true
daemon_opt=false
# A Python pipe PMDA inherits pmcd's identity.  Restart while pmcd can still
# start the PMDA as root; the agent then permanently drops to the Db2 user.
forced_restart=true

conf=$PCP_SYSCONF_DIR/$iam/$iam.conf
[ -f "$conf" ] || { echo "Error: missing config file $conf"; exit 1; }
$PCP_PYTHON_PROG - "$conf" <<'PY' || exit 1
import configparser, os, pwd, sys

def accessible(account, path, mode):
    """Check path access with the configured account's credentials.

    Mode bits alone reject POSIX ACL grants, so resolve the path with
    access(2) in a child that has dropped to the target user.  access(2)
    also checks search permission on every parent directory.
    """
    if os.geteuid() != 0:
        return os.access(path, mode)
    try:
        pid = os.fork()
    except OSError:
        return False
    if pid == 0:
        try:
            os.initgroups(account.pw_name, account.pw_gid)
            os.setgid(account.pw_gid)
            os.setuid(account.pw_uid)
            os._exit(0 if os.access(path, mode) else 1)
        except OSError:
            os._exit(2)
    return os.waitpid(pid, 0)[1] == 0

c = configparser.ConfigParser()
try:
    c.read(sys.argv[1])
except configparser.Error as error:
    raise SystemExit('Error: cannot parse %s: %s' % (sys.argv[1], error))
if not c.has_section('db2'):
    raise SystemExit('Error: missing [db2] section in %s' % sys.argv[1])
d = c['db2']
try:
    u = pwd.getpwnam(d.get('user', 'db2inst1'))
except KeyError:
    raise SystemExit('Error: unknown db2local user ' + d.get('user', 'db2inst1'))
bindir = d.get('bin_dir', '/opt/ibm/db2/V11.5/bin')
profile = d.get('profile', '~/sqllib/db2profile')
if bindir.startswith('~') and not bindir.startswith('~/'):
    raise SystemExit('Error: invalid db2local bin_dir expansion')
if profile.startswith('~') and not profile.startswith('~/'):
    raise SystemExit('Error: invalid db2local profile expansion')
bindir = u.pw_dir + bindir[1:] if bindir.startswith('~/') else bindir
profile = u.pw_dir + profile[1:] if profile.startswith('~/') else profile
bindir = os.path.realpath(bindir)
profile = os.path.realpath(profile)
if not os.path.isabs(bindir) or not os.path.isdir(bindir):
    raise SystemExit('Error: invalid db2local bin_dir')
if not os.path.isabs(profile) or not os.path.isfile(profile):
    raise SystemExit('Error: invalid db2local profile')
if not accessible(u, profile, os.R_OK):
    raise SystemExit('Error: db2local profile is not readable by ' + u.pw_name)
admdir = os.path.join(os.path.dirname(profile), 'adm')
for tool in ('db2', 'db2level', 'db2diag', 'db2pd'):
    for directory in (bindir, admdir):
        path = os.path.normpath(os.path.join(directory, tool))
        if not path.startswith(directory + os.sep) or not os.path.isfile(path):
            continue
        if accessible(u, path, os.X_OK):
            break
    else:
        raise SystemExit('Error: missing db2local tool %s for %s' % (tool, u.pw_name))
PY

pmdaSetup
pmdaInstall
exit
