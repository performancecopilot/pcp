[Unit]
Description=Daily atop archive rotation and maintenance
Documentation=man:pcp-atop(1)

[Service]
Type=oneshot
# restart seals yesterday's archive (pmiEnd on stop), then ExecStartPre
# in atop.service atomically renames prior-day files, forks background
# compression and culls old archives before recording resumes on the new
# date-stamped archive.  Compression runs in parallel with recording.
ExecStart=systemctl restart atop.service
# Hardening: no SystemCallFilter (performance impact).
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
KeyringMode=private
UMask=0027
