<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>io.pcp.pmlogger</string>
        <key>ProgramArguments</key>
        <array>
            <string>/usr/local/libexec/pcp/bin/pmlogger_farm</string>
            <string>--quick</string>
        </array>
        <key>Disabled</key>
        <false/>
        <key>UserName</key>
        <string>pcp</string>
        <key>GroupName</key>
        <string>pcp</string>
        <key>KeepAlive</key>
        <true/>
        <key>ThrottleInterval</key>
        <integer>30</integer>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/var/lib/pcp</string>
        <key>StandardErrorPath</key>
        <string>/var/log/pcp/pmlogger/plist.stderr</string>
        <key>StandardOutPath</key>
        <string>/var/log/pcp/pmlogger/plist.stdout</string>
    </dict>
</plist>
