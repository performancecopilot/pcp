#!/bin/sh
#
# generic PCP daemon stopper, starter, restarter and status
# checker ... same script used for all actions, $0 => action
#

action=`basename $0`

debug=false
#debug# debug=true

tmp=/tmp/$action-$$
seq_full=$tmp.full
sts=1		# failure is the default
trap "rm -f $tmp.*; exit \$sts" 0 1 2 3 15

# find the base of the PCP git tree, if it exists
#
here=`pwd`
topdir=''
while true
do
    if [ -d .git -a -f VERSION.pcp ]
    then
	topdir=`pwd`
	break
    fi
    if [ `pwd` = "/" ]
    then
	$debug && echo >&2 "$action: Warning: no .git between / and $here, do you know what you're doing?"
	break
    fi
    cd ..
done
cd $here

if [ -n "$topdir" -a -f "$topdir/src/include/pcp.conf" ]
then
    $debug && echo >&2 "$action: Info: using $topdir/src/include/pcp.conf"
    . "$topdir/src/include/pcp.conf"
else
    if [ -f /etc/pcp.conf ]
    then
	$debug && echo >&2 "$action: Info: using /etc/pcp.conf"
	. /etc/pcp.conf
    else
	echo "$action: Error: cannot find pcp.conf"
	exit
    fi
fi

src=''
for try in "$topdir"/qa/common.check /var/lib/pcp/testsuite/common.check
do
    if [ -f "$try" ]
    then
	$debug && echo >&2 "$action: Info: using $try for _service() et al"
	src="$try"
	break
    fi
done

if [ -z "$src" ]
then
    echo "$action: Error: cannot find common.check for _service()"
    exit
fi

awk <"$src" >$tmp.sh '
/^_systemctl_status[(]/	{ want = 1 }
/^_service[(]/		{ want = 1 }
want == 1		{ print
			  if ($1 == "}") want = 0
			}'

# set some variables used in _service()
#
sudo=sudo

# if systemctl is present and functional, then use this to start
# and stop services
#
PCPQA_SYSTEMD=no
if which systemctl >/dev/null 2>&1
then
    # we have a systemctl executable, but it might be disabled,
    # e.g. on MX Linux
    #
    if systemctl -q is-active local-fs.target >/dev/null 2>&1
    then
	# OK, good to go with systemd and systemctl
	#
	PCPQA_SYSTEMD=yes
    fi
fi
export PCPQA_SYSTEMD

. $tmp.sh

if _service "$@" $action
then
    # success ...
    #
    sts=0
fi | cat
