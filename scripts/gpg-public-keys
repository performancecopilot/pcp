#!/bin/sh
#
# Import the PCP package signing key from a public keyserver.
#
keyserver=hkps://keyserver.ubuntu.com
keyid=D87805D281D85A13539CB4BFA51D3ADCDEA2C114

gpg --keyserver "$keyserver" --recv-keys "$keyid"
gpg --list-keys "$keyid"

echo "For builds:"
echo "RPM_SIGN_KEYID=$keyid"; export RPM_SIGN_KEYID
echo "DEB_SIGN_KEYID=$keyid"; export DEB_SIGN_KEYID
