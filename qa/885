#!/bin/sh
# PCP QA Test No. 885
# Verify /proc/cpuinfo parsing for various architectures.
#
# Copyright (c) 2014 Red Hat.  All Rights Reserved.
#

seq=`basename $0`
echo "QA output created by $seq"

# get standard environment, filters and checks
. ./common.product
. ./common.filter
. ./common.check

[ $PCP_PLATFORM = linux ] || _notrun "Linux cpuinfo test, only works with Linux"

status=1	# failure is the default!
trap "cd $here; rm -rf $tmp.*; exit \$status" 0 1 2 3 15

# real QA test starts here
root=$tmp.root
LINUX_STATSPATH=$root; export LINUX_STATSPATH
files=`echo $here/linux/cpuinfo-* | LC_COLLATE=POSIX sort`
metrics=`pminfo hinv.cpu | grep -E -v 'online|thermal_throttle|frequency_scaling'`

for file in $files
do
    rm -fr $root
    mkdir -p $root/proc || _fail "root in use when processing $file"

    cp $file $root/proc/cpuinfo
    base=`basename $file`
    ncpu=`echo $base | sed -e 's/.*-\([0-9][0-9]*\)cpu-.*/\1/'`
    arch=`echo $base | sed -n -E -e '/.*-[0-9][0-9]*cpu-([a-z][a-z0-9_]*)($|-.*)/s//\1/p'`
    _make_proc_stat $root/proc/stat $ncpu
    LINUX_NCPUS=$ncpu; export LINUX_NCPUS
    debug=''
    case "$file"
    in
	$here/linux/cpuinfo-8cpu-aarch64-linux-3.17.0)
	    # debug='-Dappl9,desperate'
	    _triage_wait_point "about to try LINUX_STATSPATH=$root LINUX_NCPUS=$ncpu FAKEUNAME_MACHINE=$arch LD_PRELOAD=$here/src/fakeuname.so pminfo $debug -f -L $metrics kernel.uname.machine"
	    ;;
    esac

    echo "== Checking CPU hardware metrics from $base ($ncpu CPU)" | tee -a $seq_full
    echo "arch=$arch ncpu=$ncpu debug=$debug" >>$seq_full
    FAKEUNAME_MACHINE="$arch" LD_PRELOAD=$here/src/fakeuname.so pminfo $debug -f -L $metrics kernel.uname.machine
    echo && echo "== done" && echo
    cd $here
done

echo
echo '+++ now some error cases ...'

echo
echo '--- nothing tricky'
cat <<End-of-File >$root/proc/cpuinfo
processor       : 0
model name      : Foo-Bar no issues
End-of-File
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name

echo
echo '--- no whitespace'
cat <<End-of-File >$root/proc/cpuinfo
processor:0
model name:Foo-Bar no whitespace
End-of-File
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name

echo
echo '--- mixed whitespace (spaces and tabs)'
cat <<End-of-File >$root/proc/cpuinfo
processor 	:	 0
model name	 : 	Foo-Bar mixed whitespace
End-of-File
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name

echo
echo '--- no value after :'
cat <<End-of-File >$root/proc/cpuinfo
processor  : 0
flags      : 
model name : Foo-Bar no value for flags
End-of-File
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name hinv.cpu.flags

echo
echo '--- missing :'
cat <<End-of-File >$root/proc/cpuinfo
processor  : 0
flags
model name : Foo-Bar missing colon
End-of-File
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name hinv.cpu.flags

echo
echo '--- value and no newline'
cat <<End-of-File >$root/proc/cpuinfo
processor  : 0
flags      : mumble fumble
End-of-File
printf '%s' 'model name : Foo-Bar value and no newline' >>$root/proc/cpuinfo
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name hinv.cpu.flags

echo
echo '--- no value and no newline'
cat <<End-of-File >$root/proc/cpuinfo
processor  : 0
model name : Foo-Bar no value and no newline
End-of-File
printf '%s' 'flags :' >>$root/proc/cpuinfo
LINUX_STATSPATH="$root" FAKEUNAME_MACHINE="i686" LINUX_NCPUS=1 LD_PRELOAD=$here/src/fakeuname.so pminfo -Dappl9,desperate -f -L hinv.cpu.model_name hinv.cpu.flags


