#!/bin/sh
# PCP QA Test No. 1965
# derived metric ternary expr issue rased by @coderabbitai in the
# context of PR #2779
#
# non-valgrind variant, see qa/1966 for the valgrind variant
#
# Copyright (c) 2026 Ken McDonell.  All Rights Reserved.
#

if [ $# -eq 0 ]
then
    seq=`basename $0`
    echo "QA output created by $seq"
else
    # use $seq from caller, unless not set
    [ -n "$seq" ] || seq=`basename $0`
    echo "QA output created by `basename $0` $*"
fi

# get standard environment, filters and checks
. ./common.product
. ./common.filter
. ./common.check

do_valgrind=false
if [ "$1" = "--valgrind" ]
then
    _check_valgrind
    do_valgrind=true
elif which valgrind >/dev/null 2>&1
then
    [ "$PCPQA_VALGRIND" = both ] || \
        _notrun "valgrind variant qa/1966 will be run"
fi

_cleanup()
{
    cd $here
    $sudo rm -rf $tmp $tmp.*
}

status=0	# success is the default!
trap "_cleanup; exit \$status" 0 1 2 3 15

_filter()
{
    sed \
	-e "s@$tmp@TMP@g" \
	-e "s@/privateTMP@TMP@g" \
    # end
}

# real QA test starts here
cat <<'End-of-File' >$tmp.conf
nv.eq = hinv.map.cpu_num != 2 ? novalue(meta=hinv.map.cpu_num) : hinv.map.cpu_num
nv.lt = hinv.map.cpu_num >= 2 ? novalue(meta=hinv.map.cpu_num) : hinv.map.cpu_num
nv.ge = hinv.map.cpu_num < 2 ? novalue(meta=hinv.map.cpu_num) : hinv.map.cpu_num
nv.ne = hinv.map.cpu_num == 2 ? novalue(meta=hinv.map.cpu_num) : hinv.map.cpu_num
End-of-File

PCP_DERIVED_CONFIG=$tmp.conf
export PCP_DERIVED_CONFIG

# set this for very detailed debug output from derive_fetch.c
#
#debug=-Dderive,appl2,desperate

if $do_valgrind
then
    _run_valgrind pminfo -f -a archives/pcp-mpstat2 nv
else
    pminfo $debug -f -a archives/pcp-mpstat2 nv 2>&1
fi \
| _filter

# success, all done
exit
