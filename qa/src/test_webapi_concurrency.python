#!/usr/bin/env pmpython
#
# Exercise concurrent pmproxy /pmapi derive and fetch operations.
#
# This is a regression test for the pmproxy SIGSEGV that occurred when
# libuv timer handles were manipulated from libuv worker threads, i.e.
# concurrent requests refreshing the same webapi context.
#
# Copyright (c) 2026 Red Hat.
#
# This program is free software; you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the
# Free Software Foundation; either version 2 of the License, or (at your
# option) any later version.
#

import argparse
import http.client
import json
import socket
import sys
import threading
import time
import urllib.parse

CLIENTS = 4
ROUNDS = 60
MAX_RESPONSE = 64 * 1024 * 1024
EXPRS = [f"kernel.all.nprocs + {i}" for i in range(30)]
NAMES = [f"webapi.timer.e{i}" for i in range(len(EXPRS))]


def request(host, port, path, timeout=60):
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        conn.request("GET", path)
        response = conn.getresponse()
        return response.status, response.read()
    finally:
        conn.close()


def test_slow_chunked_close(host, port):
    """A chunked reply with Connection: close must send every chunk.

    pmproxy writes streamed results as many small chunks.  When the
    client reads slowly the final (terminating) chunk is queued while
    earlier writes are still outstanding; closing the connection when
    any one of those completes truncates the reply.  Read deliberately
    slowly with a tiny receive buffer to exercise that path.
    """
    status, body = request(host, port,
            "/pmapi/context?hostspec=localhost&polltimeout=120")
    if status != 200:
        print("slow chunked close: FAIL (context status %d)" % status)
        return False
    ctx = json.loads(body)["context"]

    req = ("GET /pmapi/%s/_metric?prefix= HTTP/1.1\r\n"
           "Host: %s\r\nConnection: close\r\n\r\n" % (ctx, host))
    data = b""
    sock = None
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1024)
        sock.settimeout(60)
        sock.connect((host, port))
        sock.sendall(req.encode())
        # let the server fill its socket send buffer and queue writes
        time.sleep(0.5)
        while len(data) < MAX_RESPONSE:
            chunk = sock.recv(8192)
            if not chunk:
                break
            data += chunk
            time.sleep(0.001)
    except OSError:
        data = b""
    finally:
        try:
            sock.close()
        except OSError:
            pass

    header = data.split(b"\r\n\r\n", 1)[0].lower()
    ok = (data.startswith(b"HTTP/1.1 200") and
          b"transfer-encoding: chunked" in header and
          data.endswith(b"0\r\n\r\n"))
    print("slow chunked close: " + ("PASS" if ok else "FAIL"))
    return ok


def derive_path(ctx, name, expr):
    params = urllib.parse.urlencode({"name": name, "expr": expr})
    return f"/pmapi/{ctx}/derive?{params}"


def main():
    parser = argparse.ArgumentParser(
        description="pmproxy concurrent /pmapi derive and fetch check")
    parser.add_argument("--host", default="localhost")
    parser.add_argument("--port", type=int, default=44322)
    args = parser.parse_args()

    print("clients: %d rounds: %d" % (CLIENTS, ROUNDS))

    # Wait for the private pmproxy to start accepting requests, then
    # create the context all of the clients will share.
    ctx = None
    for _ in range(150):
        try:
            status, body = request(args.host, args.port,
                    "/pmapi/context?hostspec=localhost&polltimeout=120")
            if status == 200:
                ctx = json.loads(body)["context"]
                break
        except (OSError, ValueError, http.client.HTTPException):
            pass
        time.sleep(0.2)

    if ctx is None:
        print("unable to create PMAPI context")
        return 1

    registered = 0
    for name, expr in zip(NAMES, EXPRS):
        try:
            status, body = request(args.host, args.port,
                    derive_path(ctx, name, expr))
        except (OSError, http.client.HTTPException):
            print("unable to register derived metrics")
            return 1
        if status == 200:
            registered += 1

    print("registered derived metrics: %d" % registered)
    if registered != len(NAMES):
        print("concurrent derive/fetch: FAIL (registration)")
        return 1

    failures = []
    lock = threading.Lock()

    def client(k):
        share = ",".join(NAMES[k::CLIENTS])
        for r in range(ROUNDS):
            try:
                # fetch this client's share of the derived metrics
                status, body = request(args.host, args.port,
                        f"/pmapi/{ctx}/fetch?names={share}")
                if status != 200:
                    raise RuntimeError("fetch status %d" % status)

                # re-register a rotating subset; a duplicate name is
                # expected to be refused with HTTP 400
                for i, expr in enumerate(EXPRS):
                    if (i + r) % 5 == k:
                        status, body = request(args.host, args.port,
                                derive_path(ctx, NAMES[i], expr))
                        if status not in (200, 400):
                            raise RuntimeError("derive status %d" % status)
            except (OSError, http.client.HTTPException, RuntimeError) as exc:
                with lock:
                    failures.append("client %d round %d: %s" %
                                    (k, r, type(exc).__name__))
                return
            time.sleep(0.01)

    threads = [threading.Thread(target=client, args=(k,))
               for k in range(CLIENTS)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()

    if failures:
        print("concurrent derive/fetch: FAIL")
        for failure in sorted(failures):
            print("  " + failure)
        return 1

    # the original bug killed pmproxy, so make sure it still responds
    try:
        status, body = request(args.host, args.port,
                "/pmapi/context?hostspec=localhost&polltimeout=5")
    except (OSError, http.client.HTTPException):
        status = 0
    if status != 200:
        print("concurrent derive/fetch: FAIL (pmproxy not responding)")
        return 1

    print("concurrent derive/fetch: PASS")
    if not test_slow_chunked_close(args.host, args.port):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
