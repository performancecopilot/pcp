#!/bin/sh
# PCP QA Test No. 1632
# pmdaopentelemetry scalability testing
# specifically scaling number of metrics per nodes
#
# Copyright (c) 2025 Red Hat.  All Rights Reserved.
#

seq=`basename $0`
echo "QA output created by $seq"

# get standard environment, filters and checks
. ./common.opentelemetry

_pmdaopentelemetry_check || _notrun "opentelemetry pmda and/or load generator not installed"

status=1        # failure is the default!
$sudo rm -rf $tmp $tmp.* $seq.full
totalendpoints=5 #total queue to work through
endpoints=5 #opentelemetry endpoints
iterations=5
metrics=400
instances=10

_cleanup()
{
    # load generator exits itself for this test

    echo "=== endpoint log ===" >>$seq_full
    if [ -f $tmp.endpoint ]
    then
        cat $tmp.endpoint >>$seq_full
    else
        echo "Error: endpoint log file is missing" >>$seq_full
    fi
    if ! _service pmlogger start >$tmp.tmp 2>&1; then cat $tmp.tmp; _exit 1; fi
    _filter_pcp_start <$tmp.tmp >>$seq_full
    _wait_for_pmlogger

    cd $here
    _pmdaopentelemetry_cleanup
    $sudo rm -rf $tmp $tmp.*
}

_check_generator()
{
    if [ -z "$pid" ]
    then
	echo "_check_generator: source$1 iter $2: no pid?"
	return 1
    fi
    if kill -0 "$pid" 2>/dev/null
    then
	return 0
    else
	echo "_check_generator: source$1 iter $2: pid=$pid has gone"
	return 1
    fi
}

_prepare_pmda opentelemetry
trap "_cleanup; exit \$status" 0 1 2 3 15
_stop_auto_restart pmcd

# make sure the primary pmlogger is not sucking opentelemetry metrics
# and draining the QA supply
#
if ! _service pmlogger stop >$tmp.tmp 2>&1; then cat $tmp.tmp; _exit 1; fi
_filter_pcp_stop <$tmp.tmp >>$seq_full

_pmdaopentelemetry_save_config
PCP_DEBUG=labels _pmdaopentelemetry_install

port=`_find_free_port 10000`
echo "port=$port" >>$seq_full

$python $here/opentelemetry/opentelemetry_endpoint.python \
        --port=$port \
        --output=$PCP_PMDAS_DIR/opentelemetry/config.d/ \
        --total $totalendpoints \
        --endpoints $endpoints \
        --metrics $metrics \
        --instances $instances \
        --limit $iterations >$tmp.endpoint 2>&1 &
pid=$!
echo "pid=$pid" >>$seq_full
$PCP_PS_PROG $PCP_PS_ALL_FLAGS | grep -E "[P]PID| $pid " | grep -v grep >>$seq_full
if ! _pmdaopentelemetry_wait_for_metric opentelemetry.source4
then
    status=1
    exit
fi
if pminfo -b 1000000 -v `pminfo opentelemetry.source0 | LC_COLLATE=POSIX sort` > $tmp.info 2> $tmp.err
then
    :
else
    echo "... failed! ... here is the Install log ..."
    cat $tmp.out
fi
cat $tmp.info $tmp.err

if pminfo -b 1000000 -ftd `pminfo opentelemetry.source1 | LC_COLLATE=POSIX sort` > $tmp.info 2>$tmp.err
   then
    echo "Fetch and desc opentelemetry metrics: success"
    cat $tmp.info
else
    echo "Fetch and desc opentelemetry metrics: failed"
    cat $tmp.err
fi

for i in `seq 0 1 4`
do
    _check_generator $i 1 || exit
    pminfo -b 10000000 -tf `pminfo opentelemetry.source$i | LC_COLLATE=POSIX sort`
    _check_generator $i 2 || exit
    pminfo -b 10000000 -tf `pminfo opentelemetry.source$i | LC_COLLATE=POSIX sort`
    _check_generator $i 3 || exit
    pminfo -b 10000000 -tf `pminfo opentelemetry.source$i | LC_COLLATE=POSIX sort`
    _check_generator $i 4 || exit
    pminfo -b 10000000 -tf `pminfo opentelemetry.source$i | LC_COLLATE=POSIX sort`
    sleep 0.5
done

_pmdaopentelemetry_remove

# success, all done
status=0
exit
