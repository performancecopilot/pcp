# This is really a full QA test for stress testing pmcd's protocol
# handling ... set the shell variables
# $pdu_data
#	ascii pdu specifications suitable for src/pdu-gadget or binary
#	protocol data stream, these typically contain malformed PDUs
#	(see the qa/pdudata directory for examples) ... this needs
#	to be a relative path
# $grep_pattern
#	a grep -E pattern for scanning pmcd.log once the test has been
#	run
# and then source this file

[ -z "$pdu_data" ] && echo "Botch! \$pdu_data not set" && exit 1
[ -z "$grep_pattern" ] && echo "Botch! \$grep_pattern not set" && exit 1

# get standard environment, filters and checks
. ./common.product
. ./common.filter
. ./common.check

[ ! -f "$here/$pdu_data" ] && echo "Botch! PDU data file $here/$pdu_data not found" && exit 1


which nc >/dev/null 2>&1 || _notrun "no nc executable installed"
# Need nc option to terminate when EOF encountered on stdin,
# but unfortunately there are multiple versions of nc(1) ...
nc --help >$tmp.out 2>&1
if grep -q '.-[^ ]*N' $tmp.out
then
    __nc_opt=-N
elif grep -q '.--send-only' $tmp.out
then
    __nc_opt="--send-only"
else
    cat $tmp.out >>$seq_full
    _notrun 'nc --help is not helping ... see $seq_full'
fi
_check_valgrind

_cleanup()
{
    cat pmcd.log >>$seq_full
    cd $here
    $sudo rm -rf $tmp $tmp.*
}

status=0	# success is the default!
trap "_cleanup; exit \$status" 0 1 2 3 15

_filter()
{
    sed \
	-e '/^Command: /d' \
    # end
}

_filter_pmcd()
{
    sed \
	-e 's/fd=[0-9][0-9]*/fd=N/g' \
	-e 's/^\[.*\] pmcd([0-9]*) [A-Za-z]*: //' \
    # end
}

mkdir $tmp || exit 1
cd $tmp
grep sampledso $PCP_PMCDCONF_PATH >pmcd.conf
$PCP_AWK_PROG <$PCP_PMCDCONF_PATH >>pmcd.conf '
$1 == "[access]"	{ print ""; want = 1 }
want == 1		{ print }'
cat pmcd.conf >>$seq_full
__port=`_find_free_port`
echo "__port=$__port" >>$seq_full

# real QA test starts here
valgrind --leak-check=full $PCP_BINADM_DIR/pmcd -f -Dpdu,appl3,attr -c ./pmcd.conf -s ./pmcd.socket -p $__port  >out 2>err &
valgrind_pid=$!

# is the process still running (kill -0 says yes for zombies too, so look at
# the process state)
#
_pmcd_alive()
{
    __st=`$PCP_PS_PROG -o stat= -p $1 2>/dev/null`
    if [ -z "$__st" ]
    then
	# $PCP_PS_PROG does not understand -o stat= (Solaris uses s/state),
	# so fall back to plain -p: a live process counts as alive and a
	# zombie only costs the bounded poll below
	$PCP_PS_PROG -p $1 >/dev/null 2>&1
	return
    fi
    case "$__st"
    in
    *[zZ]*)	return 1 ;;
    esac
    return 0
}

# Wait until pmcd has finished starting up before feeding it the PDU.
#
# This used to be a fixed "sleep 2".  pmcd binds its request port(s), creates
# its log, and only then loads the PMNS and the PMDA configuration and enters
# ClientLoop().  Under valgrind that last part takes a second or more, and it
# takes longer on slow or loaded hosts (cold caches, a single CPU, emulated
# machines).  When the PDU was sent into that window the connection was
# refused, ncat --send-only discarded it silently, and the only trace left was
# the missing expected error line.  Worse, if the SIGTERM in the shutdown below
# landed in that window too, nothing exited and the "wait" blocked until
# check(1)'s 5 minute timeout killed the test, leaving behind nothing but a
# missing pmcd.log.
#
# pmcd flushes "pmcd: PID = <pid>, PDU version = ..." to its log just before
# calling ClientLoop(), so that line marks the moment it starts serving.  Watch
# for it rather than using a client connection as the readiness probe: every
# client PDU is logged (we run with -Dpdu) and, for example, 1561 counts the
# DoCreds lines in its expected output.
#
sleep 2
__ready=''
__i=0
while [ $__i -lt 300 ]		# 30s
do
    if grep -q '^pmcd: PID = ' pmcd.log 2>/dev/null
    then
	__ready=yes
	break
    fi
    _pmcd_alive $valgrind_pid || break
    pmsleep 0.1
    __i=`expr $__i + 1`
done
echo "pmcd startup complete after $__i iteration(s)" >>$seq_full
if [ -z "$__ready" ]
then
    echo "Arrgh! pmcd did not start on port $__port" >&2
    cat out err >>$seq_full 2>&1
    [ -f pmcd.log ] && cat pmcd.log >>$seq_full 2>&1
    kill -KILL $valgrind_pid 2>/dev/null
    wait $valgrind_pid
    _fail "pmcd failed to start under valgrind (see $seq_full)"
fi

__pmcd_pid=`$PCP_PS_PROG $PCP_PS_ALL_FLAGS | grep '[p]mcd -f -Dpdu' | $PCP_AWK_PROG '{ print $2 }'`
echo "__pmcd_pid=$__pmcd_pid" >>$seq_full
[ -z "$__pmcd_pid" ] && \
    _fail "no pmcd process found after startup (see $seq_full)"
case "`file $here/$pdu_data`"
in
    *'ASCII text'*)
	# assume ascii PDU specification as input to pdu-gadget
	$here/src/pdu-gadget -p $__port <$here/$pdu_data 2>$tmp.err
	;;
    *)
	# assume binary data, e.g. SUSE reproducers
	rm -f $tmp.err
	nc $__nc_opt <$here/$pdu_data localhost $__port 2>&1 \
	;;
esac \
| od -X >>$seq_full
sleep 2

# Shut pmcd down, but never wait forever ... if pmcd ignores SIGTERM (or has
# not finished starting) a bare "wait" consumes the whole harness timeout and
# tells us nothing.  poll for at most 20s, then SIGKILL, and only reap the
# valgrind job (never "wait" for all children).
kill -TERM $__pmcd_pid 2>/dev/null
__i=0
while [ $__i -lt 200 ] && _pmcd_alive $valgrind_pid
do
    pmsleep 0.1
    __i=`expr $__i + 1`
done
if [ $__i -ge 200 ]
then
    echo "pmcd did not exit 20s after SIGTERM, sending SIGKILL" >>$seq_full
    kill -KILL $__pmcd_pid $valgrind_pid 2>/dev/null
fi
wait $valgrind_pid

[ -s $tmp.err ] && cat $tmp.err

echo "expect error(s) to be logged ..."
grep -E "$grep_pattern" pmcd.log | _filter_pmcd

echo
echo "and no valgrind badness ..."
cat out err | _filter_valgrind | _filter

# success, all done
exit
