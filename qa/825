#!/bin/sh
# PCP QA Test No. 825
# Validate the ds389 PMDA metric namespace in a static archive.
#
# Copyright (c) 2014-2015 Red Hat.

seq=`basename $0`
echo "QA output created by $seq"

. ./common.product
. ./common.filter
. ./common.check

archive=$here/archives/ds389

[ -f "$archive.meta" ] || _notrun "ds389 archive is not installed"

echo
echo "=== ds389 metrics ==="
pminfo -a "$archive" \
    ds389.cn.uptime \
    ds389.userroot.currententrycachecount \
    ds389.collide_2e1.nsruvReplicaLastModified \
    ds389.collide_2e2.nsruvReplicaLastModified \
    ds389.ipaca_mon.currententrycachecount

exit
